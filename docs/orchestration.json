{
  "$schema": "https://example.invalid/flakeradar/orchestration.schema.json",
  "project": "flakeradar",
  "repository": "rogerchappel/flakeradar",
  "defaultBranch": "main",
  "principles": [
    "offline-first",
    "deterministic-reports",
    "redaction-by-default",
    "explicit-failure-gates"
  ],
  "verification": [
    "npm test",
    "npm run check",
    "npm run build",
    "npm run smoke",
    "bash scripts/validate.sh"
  ],
  "smokeCommand": "node dist/src/cli.js run --repeat 4 --out /tmp/flakeradar-smoke.md --json /tmp/flakeradar-smoke.json -- node examples/fixtures/flaky-output.mjs --mode alternating",
  "outputs": {
    "markdown": "flake-report.md",
    "json": "flake-report.json"
  }
}
