{
  "name": "flakeradar",
  "version": "0.1.0",
  "description": "A tiny offline harness for spotting flaky local commands before they fool your agents.",
  "type": "module",
  "bin": {
    "flakeradar": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "flake",
    "flaky-tests",
    "cli",
    "testing",
    "agent-tools",
    "deterministic"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/flakeradar.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/flakeradar/issues"
  },
  "homepage": "https://github.com/rogerchappel/flakeradar#readme"
}
